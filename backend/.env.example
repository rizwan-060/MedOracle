# MedOracle Backend Environment Configuration Example
# Copy to .env and customize for local development.

# Application
APP_NAME=MedOracle
APP_ENV=development
DEBUG=true
VERSION=0.1.0
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5000","http://localhost:8000","http://localhost:8080","http://127.0.0.1:3000","http://127.0.0.1:8000"]

# Database (PostgreSQL via psycopg 3; SQLite used in unit tests)
DATABASE_URL=postgresql+psycopg://medoracle_user:CHANGE_ME@localhost:5432/medoracle_db

# Security & Authentication
SECRET_KEY=REPLACE_WITH_A_LOCAL_SECRET_KEY_FOR_DEVELOPMENT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM Providers (Groq primary, Gemini Flash fallback)
# Allowed providers: "mock" (for tests/offline), "groq", "gemini"
LLM_PROVIDER=mock
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_PRIMARY=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_FALLBACK=gemini-2.5-flash
